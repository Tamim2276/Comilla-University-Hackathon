# Copy this file to backend/.env and fill in your own values.
# NEVER commit .env (it is git-ignored). Every variable is optional: the defaults run offline.

# --- app
APP_ENV=dev                                  # dev | demo
PUBLIC_URL=http://localhost:8000             # your ngrok https URL once Twilio is wired (step 15)
FRONTEND_ORIGINS=http://localhost:5173       # comma separated

# --- database: Postgres from docker-compose.yml (in this folder; it reads the three POSTGRES_* values below)
# DATABASE_URL must use the same user, password and database name:
#   postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<DB_HOST>:<DB_PORT>/<POSTGRES_DB>
# DB_HOST is localhost when the backend runs on this machine; DB_PORT is 5432.
# Without DATABASE_URL the backend uses the SQLite file backend/data/ekcall.db (the tests always do).
POSTGRES_USER=ekcall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ekcall
DATABASE_URL=postgresql+psycopg://ekcall:change-me@localhost:5432/ekcall

# --- vector store: Chroma server from docker-compose.yml, at <CHROMA_HOST>:<CHROMA_PORT>
# Empty CHROMA_HOST: the backend uses the files in backend/data/chroma instead.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- models folder for the backend container (docker-compose.yml): router/, e5/, tfidf_router.joblib
# Default ~/Desktop/models (unzip ekcall_models.zip into ~/Desktop). The backend run without Docker
# ignores this and reads backend/data/models.
# MODELS_DIR=~/Desktop/models

# --- LLM: gemini | ollama | hybrid (FAST jobs on Ollama, MAIN on Gemini + fallback)
LLM_BACKEND=gemini
GEMINI_API_KEYS=                             # key1,key2,key3 (one per Google Cloud project)
GEMINI_MODEL_MAIN=                           # a free Flash model name from AI Studio
GEMINI_MODEL_FAST=                           # a free Flash-Lite model name from AI Studio
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite  # tried once when the model above is overloaded (503) or out of quota
GEMINI_BUDGET_S=10                           # most seconds per Gemini request (retries included), then the fallback LLM; 0 = no limit
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- order of the cloud LLMs: the first answers, each next one only when all before it are unavailable.
# Names: gemini, groq, openrouter; one without its API key below is skipped.
LLM_ORDER=gemini,groq,openrouter

# --- Groq (OpenAI-compatible). Empty key: off.
GROQ_API_KEYS=                               # key1,key2 from console.groq.com (the next key on 429/401/403)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1  # any OpenAI-compatible API works here

# --- OpenRouter (OpenAI-compatible, a ":free" model). Empty key: off.
OPENROUTER_API_KEYS=                         # key1,key2 from openrouter.ai/keys (free models: about 50 requests a day each)
OPENROUTER_MODEL=google/gemma-4-31b-it:free  # any model id ending in :free from openrouter.ai/models
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- router + retrieval
ROUTER_BACKEND=banglabert                    # banglabert | tfidf | llm (banglabert without its model folder uses tfidf)
ROUTER_CONFIDENCE_THRESHOLD=0.7
RETRIEVAL_MIN_SCORE=0.80
EMBED_MODEL=intfloat/multilingual-e5-small
HF_HUB_OFFLINE=1                             # models load from data/models only, no Hugging Face check at startup
VOICE_FAST_MODE=true
AGENT_ENGINE=langgraph                       # langgraph | stub (fixed sample answer, no keys needed)
PRELOAD_MODELS=true                          # load the router and search models at startup (first question is fast)

# --- Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                               # +1XXXXXXXXXX
STT_LANGUAGE=bn-BD                           # fallback: bn-IN
TTS_VOICE=Google.bn-IN-Standard-A
TTS_LANGUAGE=bn-IN
MISSED_CALL_MODE=false
VALIDATE_TWILIO_SIGNATURE=false              # true for the demo

# --- SMS: console | textbee
SMS_BACKEND=console
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# --- security + privacy
ADMIN_TOKEN=                                 # admin password for /admin (empty = admin closed); use "quotes" if it has ; ' or #
ADMIN_SESSION_HOURS=8                        # how long an admin login lasts (1 to 72)
PHONE_HASH_SALT=                             # any long random string; do not change it later
