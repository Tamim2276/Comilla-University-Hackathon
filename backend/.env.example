# Copy this file to backend/.env and fill in your own values.
# NEVER commit .env (it is git-ignored). Every variable is optional: the defaults run offline.

# --- app
APP_ENV=dev                                  # dev | demo
PUBLIC_URL=http://localhost:8000             # your ngrok https URL once Twilio is wired (step 15)
FRONTEND_ORIGINS=http://localhost:5173       # comma separated
# DATABASE_URL=sqlite:///./data/ekcall.db    # default: backend/data/ekcall.db

# --- LLM: gemini | ollama | hybrid (FAST jobs on Ollama, MAIN on Gemini + fallback)
LLM_BACKEND=gemini
GEMINI_API_KEYS=                             # key1,key2,key3 (one per Google Cloud project)
GEMINI_MODEL_MAIN=                           # a free Flash model name from AI Studio
GEMINI_MODEL_FAST=                           # a free Flash-Lite model name from AI Studio
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite  # tried once when the model above is overloaded (503) or out of quota
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- router + retrieval
ROUTER_BACKEND=banglabert                    # banglabert | tfidf | llm (banglabert without its model folder uses tfidf)
ROUTER_CONFIDENCE_THRESHOLD=0.7
RETRIEVAL_MIN_SCORE=0.80
EMBED_MODEL=intfloat/multilingual-e5-small
VOICE_FAST_MODE=true
AGENT_ENGINE=langgraph                       # langgraph | stub (fixed sample answer, no keys needed)
PRELOAD_MODELS=true                          # load the router and search models at startup (first question is fast)

# --- Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                               # +1XXXXXXXXXX
STT_LANGUAGE=bn-BD                           # fallback: bn-IN
TTS_VOICE=Google.bn-IN-Standard-A
TTS_LANGUAGE=bn-IN
MISSED_CALL_MODE=false
VALIDATE_TWILIO_SIGNATURE=false              # true for the demo

# --- SMS: console | textbee
SMS_BACKEND=console
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# --- security + privacy
ADMIN_TOKEN=                                 # admin password for /admin (empty = admin closed); use "quotes" if it has ; ' or #
ADMIN_SESSION_HOURS=8                        # how long an admin login lasts (1 to 72)
PHONE_HASH_SALT=                             # any long random string; do not change it later
